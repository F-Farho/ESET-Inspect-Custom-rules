<?xml version="1.0" encoding="utf-8"?>
<rule>
    <description>
        <name>AI Agent or MCP Runtime Accessing Development Credential Stores [FF2027b]</name>
        <category>Discovery</category>
        <os>Windows</os>
        <severity>60</severity>
        <mitreattackid>T1555,T1552.001,T1005</mitreattackid>
        <explanation>Detects AI agents, AI-enabled development environments, or AI/MCP runtimes reading development credential stores monitored by ESET Inspect, including Git and Subversion credential files.</explanation>
        <maliciousCauses>A compromised AI agent, malicious MCP server, malicious extension, or prompt-driven tool execution may access development credentials for repository access, source-code theft, further compromise, or lateral movement.</maliciousCauses>
        <benignCauses>Authorized AI-assisted development workflows may legitimately access Git or Subversion credentials. Shared runtimes are restricted using AI or MCP-related command-line indicators.</benignCauses>
        <recommendedActions>1. Review the triggering process and command line.
2. Identify the Git or Subversion credential file accessed.
3. Review the complete process tree and identify the originating AI application, extension, agent, or MCP server.
4. Determine whether repository credential access was required by the workflow.
5. Review subsequent repository, network, and process activity from the same process tree.
6. If access was unauthorized, rotate affected credentials and investigate repository access.</recommendedActions>
    </description>
    <definition>
        <process>
            <operator type="OR">
                <condition component="FileItem" property="FileNameWithoutExtension" condition="is" value="claude" />
                <condition component="FileItem" property="FileNameWithoutExtension" condition="is" value="cursor" />
                <condition component="FileItem" property="FileNameWithoutExtension" condition="is" value="windsurf" />
                <condition component="FileItem" property="FileNameWithoutExtension" condition="is" value="kiro" />
                <condition component="FileItem" property="FileNameWithoutExtension" condition="is" value="goose" />
                <condition component="FileItem" property="FileNameWithoutExtension" condition="is" value="aider" />
                <condition component="FileItem" property="FileNameWithoutExtension" condition="is" value="codex" />
                <condition component="FileItem" property="FileNameWithoutExtension" condition="is" value="gemini" />
                <condition component="FileItem" property="FileNameWithoutExtension" condition="is" value="opencode" />
                <operator type="AND">
                    <condition component="FileItem" property="FileNameWithoutExtension" condition="is" value="node" />
                    <operator type="OR">
                        <condition component="ProcessInfo" property="CommandLine" condition="contains" value="@anthropic-ai/claude-code" />
                        <condition component="ProcessInfo" property="CommandLine" condition="contains" value="@openai/codex" />
                        <condition component="ProcessInfo" property="CommandLine" condition="contains" value="@google/gemini-cli" />
                        <condition component="ProcessInfo" property="CommandLine" condition="contains" value="@modelcontextprotocol/" />
                        <condition component="ProcessInfo" property="CommandLine" condition="contains" value="mcp-server" />
                        <condition component="ProcessInfo" property="CommandLine" condition="contains" value="cline" />
                        <condition component="ProcessInfo" property="CommandLine" condition="contains" value="continue" />
                        <condition component="ProcessInfo" property="CommandLine" condition="contains" value="roo-cline" />
                        <condition component="ProcessInfo" property="CommandLine" condition="contains" value="github.copilot" />
                        <condition component="ProcessInfo" property="CommandLine" condition="contains" value="codeium" />
                        <condition component="ProcessInfo" property="CommandLine" condition="contains" value="tabnine" />
                        <condition component="ProcessInfo" property="CommandLine" condition="contains" value="cody-ai" />
                    </operator>
                </operator>
                <operator type="AND">
                    <operator type="OR">
                        <condition component="FileItem" property="FileNameWithoutExtension" condition="is" value="python" />
                        <condition component="FileItem" property="FileNameWithoutExtension" condition="is" value="pythonw" />
                        <condition component="FileItem" property="FileNameWithoutExtension" condition="is" value="uv" />
                        <condition component="FileItem" property="FileNameWithoutExtension" condition="is" value="uvx" />
                    </operator>
                    <operator type="OR">
                        <condition component="ProcessInfo" property="CommandLine" condition="contains" value="aider" />
                        <condition component="ProcessInfo" property="CommandLine" condition="contains" value="crewai" />
                        <condition component="ProcessInfo" property="CommandLine" condition="contains" value="autogen" />
                        <condition component="ProcessInfo" property="CommandLine" condition="contains" value="open-interpreter" />
                        <condition component="ProcessInfo" property="CommandLine" condition="contains" value="openhands" />
                        <condition component="ProcessInfo" property="CommandLine" condition="contains" value="fastmcp" />
                        <condition component="ProcessInfo" property="CommandLine" condition="contains" value="mcp-server" />
                        <condition component="ProcessInfo" property="CommandLine" condition="contains" value="mcp_server" />
                    </operator>
                </operator>
            </operator>
        </process>
        <operations>
            <operation type="ReadFile">
                <operator type="OR">
                    <condition component="FileItem" property="FullPath" condition="is" value="%HOME%\.config\git\credentials" />
                    <condition component="FileItem" property="FullPath" condition="is" value="%HOME%\.git-credentials" />
                    <operator type="AND">
                        <condition component="FileItem" property="FullPath" condition="starts" value="%LOCALAPPDATA%\Packages\" />
                        <condition component="FileItem" property="FullPath" condition="contains" value="\LocalState\rootfs\home\" />
                        <condition component="FileItem" property="FullPath" condition="ends" value="\.git-credentials" />
                    </operator>
                    <condition component="FileItem" property="FullPath" condition="is" value="%APPDATA%\Subversion\auth\svn.simple" />
                </operator>
            </operation>
        </operations>
    </definition>
    <maliciousTarget name="current" />
    <actions>
        <action name="TriggerDetection" />
        <action name="StoreEvent" />
    </actions>
</rule>
