<?xml version="1.0" encoding="utf-8"?>
<rule>
    <description>
        <os>Windows</os>
        <mitreattackid>T1552</mitreattackid>
        <explanation> Adversaries may search local file systems and remote file shares for files containing insecurely stored credentials. The rule monitors for files that contain password in the name. </explanation>
        <maliciousCauses>Adversary attempts to retrieve unencrypted credentials.</maliciousCauses>
        <benignCauses>File is storing irrelevant data.</benignCauses>
        <recommendedActions>1. Evaluate the process command line. Is it expected in enterprise? 
            1. Evaluate the detected file.
            2. Start incident response process or report it accordingly.
        </recommendedActions>
        <category>Unsecured Credentials: Credentials In Files</category>
        <name>Unsecured Credentials In Files [AB1122]</name>
        <severity>55</severity>
    </description>
    <definition>
        <operations>
            <operation type="ReadFile">
                <operator type="or">
                    <condition component="FileItem" property="FileName" condition="contains" value="password" />
                    <condition component="FileItem" property="FileName" condition="contains" value="credentials" />
                    <condition component="FileItem" property="FileName" condition="contains" value="passwort" />
                    <condition component="FileItem" property="FileName" condition="contains" value="pwd" />
                </operator>
            </operation>
        </operations>
    </definition>
    <actions>
        <action name="TriggerDetection" />
        <action name="StoreEvent" />
    </actions>
</rule>

